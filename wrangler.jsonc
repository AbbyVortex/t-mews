{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-mews",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "MONITOR_ENABLED": "false",
    "EXPERIMENT_END_AT": "",
    "SOURCES_JSON": "[{\"name\":\"fxtwitter\",\"url\":\"https://fxtwitter.com/thsottiaux/feed.xml\"}]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "t-mews",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "preview_urls": false
}
